# BigWigs packager config — https://github.com/BigWigsMods/packager
# The repo is named lowercase (warlock_qol_tbc) but the shipped AddOn folder MUST be
# "Warlock_Qol_Tbc" (the .toc / ADDON_LOADED identity string depends on it), so pin it.
package-as: Warlock_Qol_Tbc

enable-nolib-creation: no

# Use our curated changelog as the release notes (GitHub release + CurseForge), instead of
# letting the packager auto-generate one from git commit messages. markup-type MUST be set
# explicitly — without it the changelog uploads as plain "text" and CurseForge shows the raw
# markdown (##, ** etc.) instead of rendering it.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Dev/CI files that should not ship inside the packaged AddOn.
ignore:
  - ".github"
  - ".gitignore"
  - ".gitattributes"
  - ".pkgmeta"
